# ─────────────────────────────────────────────────────────────────────────
# DefendableOS · environment variable contract
# Copy to repo root as `.env` and fill in real values.
# NEVER commit a populated .env file. Server-side secrets only.
# ─────────────────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
APP_NAME=DefendableOS
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql+psycopg://defendable:defendable@localhost:5432/defendableos

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Object storage (MinIO local · S3-compatible) ──
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRIVATE_BUCKET=defendable-private
S3_PUBLIC_BUCKET=defendable-public
S3_REGION=us-east-1

# ── Auth secrets ──
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# ── Brave LLM Context API (public market research) ──
BRAVE_API_KEY=
BRAVE_LLM_CONTEXT_URL=https://api.search.brave.com/res/v1/llm/context

# ── Model gateway · provider-agnostic. Switch with MODEL_PROVIDER=kimi|openai ──
MODEL_PROVIDER=kimi

# Kimi K2.6 (Moonshot · OpenAI-compatible)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
KIMI_THINKING_DEFAULT=disabled

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_ORGANIZATION=

# ── ENS · defendable.eth ──
ENS_PARENT_NAME=defendable.eth
ENS_MODE=mock
# Set to true ONLY when explicitly performing admin-triggered live issuance.
ENS_LIVE_WRITES_ENABLED=false
ENS_RPC_URL=
ENS_CHAIN_ID=
ENS_RESOLVER_ADDRESS=
# NEVER set in mock mode. NEVER log. NEVER return in an API response.
ENS_SIGNER_PRIVATE_KEY=

# ── Edge appliance enrollment ──
EDGE_ENROLLMENT_SECRET=CHANGE_ME_IN_PRODUCTION
EDGE_TOKEN_TTL_MINUTES=30

# ── Public verification ──
PUBLIC_VERIFICATION_ENABLED=true

# ── Demo / dev affordances ──
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@swarmandbee.ai
DEMO_USER_PASSWORD=defendable-demo
