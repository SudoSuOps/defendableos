{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["host", "reasoning"],
  "properties": {
    "host": {
      "type": "object",
      "required": ["cpu_model"],
      "properties": {
        "cpu_model": {"type": "string"},
        "cpu_count": {"type": ["integer", "null"]},
        "platform": {"type": "string"}
      }
    },
    "captured_at": {"type": "string"},
    "reasoning": {"type": "string", "minLength": 20}
  }
}
