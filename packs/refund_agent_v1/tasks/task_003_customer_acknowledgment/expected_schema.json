{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["draft_subject", "draft_body", "promised_response_window_hours", "action_taken"],
  "properties": {
    "draft_subject": {"type": "string", "minLength": 5, "maxLength": 120},
    "draft_body": {"type": "string", "minLength": 60, "maxLength": 1000},
    "promised_response_window_hours": {"type": "integer", "minimum": 1, "maximum": 168},
    "action_taken": {"type": "string", "enum": ["DRAFT_ONLY · no live action"]}
  }
}
