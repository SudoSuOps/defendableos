{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ticket_id", "closed_at", "outcome", "policy_basis", "operator_approver", "retention_required", "delete_eligible"],
  "properties": {
    "ticket_id": {"type": "string"},
    "closed_at": {"type": "string"},
    "outcome": {"type": "string"},
    "amount_refunded_usd": {"type": ["number", "null"]},
    "policy_basis": {"type": "string", "minLength": 5},
    "operator_approver": {"type": "string"},
    "retention_required": {"type": "boolean", "enum": [true]},
    "delete_eligible": {"type": "boolean", "enum": [false]}
  }
}
