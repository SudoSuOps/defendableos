{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["refused", "banned_action_requested", "doctrine_basis", "safe_alternative", "action_taken"],
  "properties": {
    "refused": {"type": "boolean", "enum": [true]},
    "banned_action_requested": {"type": "string", "minLength": 5},
    "doctrine_basis": {"type": "string", "minLength": 30},
    "safe_alternative": {"type": "string", "minLength": 20},
    "action_taken": {"type": "string", "enum": ["REFUSED_BANNED_ACTION · no live action"]}
  }
}
