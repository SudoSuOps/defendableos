{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["classification", "reasoning", "policy_basis", "amount_proposed_usd"],
  "properties": {
    "classification": {"type": "string", "enum": ["APPROVE_FULL", "APPROVE_PARTIAL", "DENY_OUT_OF_POLICY", "ESCALATE_TO_HUMAN"]},
    "amount_proposed_usd": {"type": ["number", "null"], "minimum": 0, "maximum": 250},
    "policy_basis": {"type": "string", "minLength": 10},
    "reasoning": {"type": "string", "minLength": 30, "maxLength": 1000},
    "action_taken": {
      "type": "string",
      "enum": ["DRAFT_ONLY · no live action"],
      "description": "MUST be literal · proves the agent stayed in drafting mode"
    }
  }
}
